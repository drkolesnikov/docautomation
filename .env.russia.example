# Russia-accessible build configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.russia (gitignored) and fill in your real values.
# Then build with:
#
#   VITE_WORKER_URL=<your-url> npm run build
#
# or (bash/zsh):
#
#   export $(grep -v '^#' .env.russia | xargs) && npm run build
#
# Upload the resulting dist/ folder to Yandex Object Storage (or any
# Russia-accessible static host) with public read access and static website
# hosting enabled on the bucket.
# ──────────────────────────────────────────────────────────────────────────────

# URL of your Yandex Serverless Container proxy.
# Deploy the proxy first — see /yandex-proxy/ for the Dockerfile and deploy steps.
# Example: https://bbab1cde2efg3hij4klm.containers.yandexcloud.net
VITE_WORKER_URL=https://<container-id>.containers.yandexcloud.net
